{
  "name": "cyrenex",
  "version": "0.2.0",
  "description": "Full-stack server apps with a Vite dev server, pondi dependency injection and typed clients.",
  "keywords": [
    "bun",
    "dependency-injection",
    "fullstack",
    "node",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/cyrenex/core#readme",
  "bugs": {
    "url": "https://github.com/cyrenex/core/issues"
  },
  "license": "MIT",
  "author": "byc <bycrxemail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyrenex/core.git",
    "directory": "packages/cyrenex"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "cyrenex-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./adapter": {
      "cyrenex-source": "./src/adapter.ts",
      "default": "./dist/adapter.mjs"
    },
    "./client": {
      "cyrenex-source": "./src/client.ts",
      "default": "./dist/client.mjs"
    },
    "./start": {
      "cyrenex-source": "./src/start.ts",
      "default": "./dist/start.mjs"
    },
    "./testing": {
      "cyrenex-source": "./src/testing.ts",
      "default": "./dist/testing.mjs"
    },
    "./vite": {
      "cyrenex-source": "./src/vite/index.ts",
      "default": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepack": "node -e \"for (const f of ['README.md', 'README.zh-CN.md', 'LICENSE']) require('node:fs').copyFileSync('../../' + f, f)\""
  },
  "dependencies": {
    "@cyrenex/pondi": "catalog:",
    "env-runner": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@elysia/node": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "elysia": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
